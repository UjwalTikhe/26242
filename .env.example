# ------------------------------------------------------------------
# SIH26242 RPL Backend - environment template
# Copy to .env at the repo root (backend loads root/.env and backend/.env)
# Local infra:  npm run infra:up   (MongoDB + Redis)
# ------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public base URL used for certificate QR + /verify links
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated CORS origins for the frontend(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/sih_rpl
# Leave empty to run without Redis (queue driver falls back to inline)
REDIS_URL=

# --- Queue: inline | bullmq | auto (auto = bullmq when REDIS_URL set) ---
QUEUE_DRIVER=inline

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
# OTP provider: mock | firebase | msg91
OTP_PROVIDER=mock
# In mock mode this fixed code is accepted (also always logged)
OTP_MOCK_CODE=123456
OTP_TTL_SEC=300
# Firebase (only when OTP_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# MSG91 (only when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- Storage driver: local | s3 ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
# Resumable-upload staging dir. MUST be inside LOCAL_STORAGE_DIR (evidence
# storage keys are paths relative to that root). Defaults to $LOCAL_STORAGE_DIR/tus.
TUS_UPLOAD_DIR=./data/storage/tus
MAX_UPLOAD_BYTES=524288000
# S3 / Cloudflare R2 (when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- AI (OpenAI-compatible). Leave AI_MODE=mock for keyless deterministic runs ---
AI_MODE=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_ASR_MODEL=whisper-1
# Confidence below this routes an item to a human assessor
AI_CONFIDENCE_HUMAN_ROUTE=0.65
